# 데이터베이스 설정
DB_HOST=db
DB_PORT=3306
DB_NAME=finwooyi_db
DB_USER=finwooyi_user
DB_PASSWORD=finwooyi_pass

# 애플리케이션 설정
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5000

# 보안 키 (변경 필수!)
ENCRYPTION_KEY=your_encryption_key_here

# 세션 설정
SESS_DRIVER=files
SESS_SAVE_PATH=/var/www/html/application/cache/sessions